# Порт, на якому працює backend
PORT=4000

# PostgreSQL (users/saved_playlists/saved_mixes) — обов'язково
DATABASE_URL=postgres://ytm:ytm@localhost:5432/ytm

# Секрет для підпису сесійної кукі — постав щось довге й випадкове
SESSION_SECRET=change-me

# (опційно) cookie-рядок з music.youtube.com для доступу до приватних/обмежених
# плейлистів. Без нього працюватимуть лише публічні/непублічні-за-посиланням плейлисти.
# Як отримати: залогінься на music.youtube.com -> DevTools (F12) -> Network ->
# знайди запит до /youtubei/v1/browse -> Headers -> скопіюй значення заголовка Cookie.
YTM_COOKIE=
